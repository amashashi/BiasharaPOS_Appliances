{
  "name": "biashara-appliances",
  "version": "0.1.0",
  "private": true,
  "description": "BiasharaPOS Appliances & Electronics Platform — monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && node scripts/check-i18n.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:pos": "npm run dev --workspace apps/pos",
    "dev:backoffice": "npm run dev --workspace apps/backoffice"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  },
  "engines": {
    "node": ">=20"
  }
}
