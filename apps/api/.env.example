# ─── Database (D-020) ────────────────────────────────────────────────
# Dev points at the Neon 'development' branch of project biashara-appliances
# (green-unit-19592753, aws-eu-central-1, PG16). Get the URL from the Neon
# console → biashara-appliances → Branches → development → Connect.
# The PRODUCTION branch URL is NEVER stored in the repo — deploys read it
# from the hosting platform's environment variables.
# Offline/local fallback (embedded Postgres, D-017; also the test default):
#   postgres://biashara:biashara@localhost:5432/biashara_appliances
DATABASE_URL=postgresql://biashara_app:<password>@<dev-endpoint>.c-4.eu-central-1.aws.neon.tech/biashara_appliances?sslmode=require

# Neon PRODUCTION branch — used ONLY by `npm run migrate:prod` (post-merge
# standing policy, D-024). Get it from Neon console → production → Connect.
PROD_DATABASE_URL=postgresql://biashara_app:<password>@<prod-endpoint>.c-4.eu-central-1.aws.neon.tech/biashara_appliances?sslmode=require

PORT=3000
