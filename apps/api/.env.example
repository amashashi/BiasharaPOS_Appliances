# ─── Database (D-020) ────────────────────────────────────────────────
# Dev points at the Neon 'development' branch of project biashara-appliances
# (green-unit-19592753, aws-eu-central-1, PG16). Get the URL from the Neon
# console → biashara-appliances → Branches → development → Connect.
# The PRODUCTION branch URL is NEVER stored in the repo — deploys read it
# from the hosting platform's environment variables.
# Offline/local fallback (embedded Postgres, D-017; also the test default):
#   postgres://biashara:biashara@localhost:5432/biashara_appliances
DATABASE_URL=postgresql://biashara_app:<password>@<dev-endpoint>.c-4.eu-central-1.aws.neon.tech/biashara_appliances?sslmode=require

# Neon PRODUCTION branch — used ONLY by `npm run migrate:prod` (post-merge
# standing policy, D-024). Get it from Neon console → production → Connect.
PROD_DATABASE_URL=postgresql://biashara_app:<password>@<prod-endpoint>.c-4.eu-central-1.aws.neon.tech/biashara_appliances?sslmode=require

PORT=3000

# ─── Fiscal retry queue (T2.4, BullMQ) ───────────────────────────────
# Local dev on Windows: Memurai serves Redis on 6379; CI uses redis:7.
REDIS_URL=redis://localhost:6379
# FISCAL_QUEUE_NAME=fiscal
# FISCAL_MAX_ATTEMPTS=8
# FISCAL_BACKOFF_MS=15000

# ─── Arrears nightly job (T3.3, BullMQ) ──────────────────────────────
# ARREARS_CRON=0 2 * * *   # nightly at 02:00; set to 'off' to disable the scheduler
# ARREARS_QUEUE_NAME=arrears

# ─── Platform identity (T5.1, D-034) ─────────────────────────────────
# IDENTITY_MODE=platform verifies bearer tokens against the real BiasharaPOS
# platform (GET /auth/me) and enables the /auth/login + /auth/refresh proxies.
# Anything else (incl. unset — the test default) keeps the HS256 stub.
IDENTITY_MODE=platform
PLATFORM_API_URL=https://app.biashara-pos.com/api/v1

# ─── Stub-era dev endpoints (D-028; removed at T5.3) ─────────────────
# The /auth/dev/mm-resolve mobile-money simulator is UNAUTHENTICATED and, against
# the stub payments service, confirms a payment with no money collected. It
# auto-disables when IDENTITY_MODE=platform (above), so real deployments are safe
# by default. DEV_AUTH=on force-enables it for a dev/staging payments demo that
# also uses real login; DEV_AUTH=off is a hard kill everywhere.
# DEV_AUTH=off

# ─── Mobile money (T5.3b, D-035) ─────────────────────────────────────
# PAYMENTS_MODE=clickpesa binds the ClickPesa aggregator (M-Pesa + Mixx by Yas
# + Airtel behind one USSD-PUSH API). Anything else (incl. unset — the test
# default) keeps the in-memory stub. Sandbox credentials come from the ClickPesa
# dashboard; the checksum key signs both outbound pushes and inbound webhooks.
# PAYMENTS_MODE=clickpesa
# CLICKPESA_BASE_URL=https://api.clickpesa.com
# CLICKPESA_CLIENT_ID=
# CLICKPESA_API_KEY=
# CLICKPESA_CHECKSUM_KEY=
